{
  "cSpell.language": "ca,en",
  "cSpell.words": [
    "colnames",
    "dplyr",
    "httpgd",
    "knitr",
    "lapply",
    "Leste",
    "ncol",
    "pandoc",
    "Preprocés",
    "readr",
    "readxl",
    "rmarkdown",
    "sapply",
    "strsplit",
    "summarise",
    "trimws"
  ],
  "editor.codeActionsOnSave": {
    "source.fixAll.markdownlint": "always"
  },
  "editor.rulers": [
    80
  ],
  "editor.formatOnSave": true,
  "github.copilot.enable": {
    "*": false,
  },
  "[markdown]": {
    "editor.formatOnPaste": true
  }
}